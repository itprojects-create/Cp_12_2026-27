# Copy to .env and fill in. Never commit .env.
# The prediction graph uses this server-side OpenRouter configuration.
OPENROUTER_API_KEY=sk-or-xxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Legacy CodeCraft compatibility settings. Leave blank when OpenRouter is configured.
CODECRAFT_KEY_1=
CODECRAFT_KEY_2=
CODECRAFT_KEY_3=
CODECRAFT_KEY_4=
CODECRAFT_KEY_5=
CODECRAFT_BASE_URL=https://codecraftapi.com/v1
ANALYST_MODEL=gpt-5.6-luna
DECIDER_MODEL=claude-sonnet-5
SESSION_TOKEN_CAP=60000
DAY_TOKEN_CAP=1500000
DATABASE_URL=
MONGO_URL=
# Browser frontend origins allowed to call /api/v1 (comma-separated).
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
# Website integration (server-only; never put these in VITE_* variables).
FYERS_ACCESS_TOKEN=
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
# Must exactly match the URL registered in the Fyers developer dashboard.
FYERS_REDIRECT_URI=http://127.0.0.1:8000/api/v1/fyers/callback
WEBSITE_API_KEY=
YAHOO_QUOTE_REFRESH_SECONDS=15
STOCK_PREDICTION_REFRESH_SECONDS=900
STOCK_PREDICTION_MAX_CONCURRENT=2
STOCK_PREDICTION_MAX_STALE_SECONDS=86400
# Proactive full-quality research; consumes the same model budget as page requests.
STOCK_PREDICTION_WARM_ENABLED=true
STOCK_PREDICTION_WARM_SYMBOLS=HDFCBANK,RELIANCE,TCS,INFY,ICICIBANK
STOCK_PREDICTION_WARM_INTERVAL_SECONDS=30
STOCK_PREDICTION_WARM_AHEAD_SECONDS=300
STOCK_PREDICTION_WARM_DAY_TOKEN_FRACTION=0.5
# Optional legacy probe aliases. The main prediction graph uses OPENROUTER_MODEL.
OPENROUTER_KEY=
OPENROUTER_DECIDER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_ANALYST_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MAX_TOKENS=8000
# Quant Plus chatbot configuration is kept in the frontend server environment.
# The standalone probe gateway remains optional; the prediction graph uses the
# provider-aware gateway in app/gateway/codecraft.py.
# Governance migration §55: authority flags. Safe defaults shown — the LLM
# research pipeline runs, but nothing LLM-originated may command capital.
# LLM_DIRECTION_AUTHORITY=false
# LLM_MONEY_AUTHORITY=false
# LLM_OVERLAY_ENABLED=false
# RESEARCH_AGENT_ENABLED=true
# RESEARCH_FOUNDRY_ENABLED=true
# RESEARCH_MEMORY_ENABLED=true
# FALSIFICATION_REQUIRED=true
# PIT_REQUIRED_FOR_PROMOTION=true
# FORWARD_REQUIRED_FOR_PROMOTION=true
